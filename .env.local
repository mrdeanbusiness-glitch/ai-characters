# Random secret for authentication. Generate a 32-character secret using:
# https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=your_generated_secret_here

# AI Gateway API key for accessing models (required for non-Vercel deployments)
# You should have created this on the AI SDK or Google API
AI_GATEWAY_API_KEY=your_ai_gateway_api_key_here

# Vercel Blob token for reading/writing files
# Create this under Vercel storage if you're storing uploaded files
BLOB_READ_WRITE_TOKEN=your_blob_token_here

# PostgreSQL database URL
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
POSTGRES_URL=your_postgres_connection_string_here

# Redis URL (used for caching, session storage, etc.)
# Format: redis://:PASSWORD@HOST:PORT
REDIS_URL=your_redis_connection_string_here
